{
  "name": "devchart-vue",
  "version": "1.0.0",
  "description": "Vue3 + Vite module for generating developer activity charts (GitHub, LeetCode)",
  "type": "module",
  "main": "dist/index.js",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc && vite build",
    "build-lib": "vite build --mode lib",
    "preview": "vite preview",
    "test": "vitest"
  },
  "keywords": [
    "vue3",
    "vite",
    "github",
    "leetcode",
    "charts",
    "heatmap",
    "contribution",
    "developer",
    "activity"
  ],
  "author": "DevChart Contributors",
  "license": "MIT",
  "dependencies": {
    "vue": "^3.4.0",
    "axios": "^1.6.0",
    "d3": "^7.8.0"
  },
  "devDependencies": {
    "@types/d3": "^7.4.0",
    "@types/node": "^20.0.0",
    "@vitejs/plugin-vue": "^5.0.0",
    "typescript": "^5.3.0",
    "vite": "^5.0.0",
    "vite-plugin-dts": "^3.6.0",
    "vue-tsc": "^1.8.0",
    "vitest": "^1.0.0"
  }
}